<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What Lathe (and LatheScanner) need under Apple's hardened runtime, which
     notarization requires. Used by the "Sign and notarize" step in build.yml. -->
<plist version="1.0">
<dict>
    <!-- Load VST3 plug-ins made (and signed) by other developers. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Some plug-ins generate code at run time. -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Record from the audio interface (the microphone permission). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
